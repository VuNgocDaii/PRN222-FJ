@model List<AspNetUser>
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Tài khoản"; var access = ViewData["Permissions"] as HashSet<string> ?? new(); var page = (int)ViewData["Page"]!; var total = (int)ViewData["Total"]!; }
<header class="page-header"><h1>Quản lý tài khoản</h1></header>
<section class="panel crud-panel"><form asp-action="Index" method="get" class="inline"><label>Tìm tài khoản<input name="search" value="@ViewData["Search"]" maxlength="200"></label><button class="primary">Tìm kiếm</button></form><p>@total tài khoản</p></section>
@if (access.Contains("accounts.create")) {
<section class="panel crud-panel"><h2>Tạo tài khoản</h2><form asp-action="Create" method="post">
<label>Tên đăng nhập<input name="UserName" required maxlength="256"></label><label>Họ tên<input name="FullName" required maxlength="150"></label><label>Mật khẩu<input name="Password" type="password" autocomplete="new-password" required minlength="8" maxlength="128"></label><button class="primary">Tạo tài khoản</button></form></section>
}
@foreach (var item in Model) {
<section class="panel crud-panel"><h2>@item.UserName</h2><p>@item.FullName · @item.VerificationStatus · @(item.IsActive ? "Hoạt động" : "Đã khóa")</p>
@if (access.Contains("accounts.update")) {
<form asp-action="Update" asp-route-id="@item.Id" method="post"><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(item.RowVersion)">
<label>Họ tên<input name="FullName" value="@item.FullName" required maxlength="150"></label>
@if (access.Contains("accounts.lock")) { <label><input name="IsActive" type="checkbox" value="true" checked="@item.IsActive"> Hoạt động</label><input name="IsActive" type="hidden" value="false"> }
else { <input name="IsActive" type="hidden" value="@item.IsActive.ToString().ToLowerInvariant()"> }
<button class="primary">Lưu tài khoản</button></form>
}
@if (access.Contains("roles.assign")) { <a asp-controller="RoleAssignments" asp-action="Index" asp-route-userId="@item.Id">Vai trò được gán</a> }
</section>
}
<nav class="inline">@if (page > 1) { <a asp-action="Index" asp-route-page="@(page - 1)" asp-route-search="@ViewData["Search"]">← Trang trước</a> }<span>Trang @(page)</span>@if (page * 30 < total) { <a asp-action="Index" asp-route-page="@(page + 1)" asp-route-search="@ViewData["Search"]">Trang sau →</a> }</nav>
