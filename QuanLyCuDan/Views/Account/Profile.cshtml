@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Thay đổi mật khẩu";
}
<header class="page-header"><h1>Thay đổi mật khẩu</h1></header>
<div id="notice" hidden role="status"></div>
@if (ViewData["CanSubmitResidentProfile"] is true)
{
    <section class="panel narrow"><h2>Bạn chưa có hồ sơ cư dân</h2><a class="primary nav-item" href="/Account/ResidentRegistration">Bổ sung thông tin cư dân</a></section>
}
<section class="panel narrow">
    <h2>Đổi mật khẩu</h2>
    <form asp-action="ChangePassword" method="post" data-password-form>
        <label>Mật khẩu hiện tại<input name="CurrentPassword" type="password" required autocomplete="current-password"></label>
        <label>Mật khẩu mới<input name="NewPassword" type="password" required minlength="8" maxlength="128" autocomplete="new-password"></label>
        <label>Xác nhận mật khẩu mới<input name="confirmPassword" type="password" required minlength="8" maxlength="128" autocomplete="new-password"></label>
        <button class="primary">Đổi mật khẩu</button>
    </form>
</section>
