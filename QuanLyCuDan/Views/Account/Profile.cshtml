@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Thay đổi mật khẩu";
}
<header class="page-header"><h1>Thay đổi mật khẩu</h1></header>
<div id="notice" hidden role="status"></div>
@if (ViewData["CanSubmitResidentProfile"] is true)
{
    <section class="panel narrow"><h2>Bạn chưa có hồ sơ cư dân</h2><p class="muted">Bổ sung ngày sinh, địa chỉ và thông tin cư trú để quản trị viên xác minh, tạo hồ sơ và cấp quyền cư dân.</p><a class="primary nav-item" href="/Account/ResidentRegistration">Bổ sung thông tin cư dân</a></section>
}
<section class="panel narrow">
    <p class="muted">Chọn “Thay đổi mật khẩu” cạnh tên tài khoản để mở cửa sổ đổi mật khẩu.</p>
</section>
