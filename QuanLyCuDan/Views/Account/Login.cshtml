@model QuanLyCuDan.Auth.LoginInput
@{ Layout = "_AccountLayout"; ViewData["Title"] = "Đăng nhập"; }
<h1>Đăng nhập</h1>

            @if (TempData["RegistrationMessage"] is string message)
            {
                <p class="message success" role="status">@message</p>
            }
            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]">
                <div asp-validation-summary="All" class="validation" role="alert">
                </div>
                <label>Tên đăng nhập<input name="UserName" value="@Model?.UserName" autocomplete="username" required maxlength="256" autofocus>
                </label>
                <label>Mật khẩu<input name="Password" type="password" autocomplete="current-password" required maxlength="256">
                </label>
                <label class="check-row"><input type="checkbox" id="show-password"> Hiện mật khẩu</label>
                <button class="primary wide" type="submit">Đăng nhập</button>
            </form>
            <p class="footnote">Chưa có tài khoản? <a asp-controller="Account" asp-action="Register">Đăng ký cư dân</a></p>


@section Scripts {
    <script>
        document.getElementById("show-password")?.addEventListener("change", function () {
            document.querySelector('input[name="Password"]').type = this.checked ? "text" : "password";
        });
    </script>
}
