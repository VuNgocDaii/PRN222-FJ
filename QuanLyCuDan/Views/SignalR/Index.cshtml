@{
    ViewData["Title"] = "Thử SignalR";
}

<h1>Thử kết nối SignalR</h1>
<p>Đăng nhập trước khi mở trang này. Nhấn nút để nhận phản hồi từ server.</p>
<p id="signalr-status" role="status">Đang kết nối...</p>
<button id="signalr-test" type="button" class="btn btn-primary" disabled>Gửi thử</button>
<ul id="signalr-messages" class="mt-3" aria-live="polite"></ul>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/notification-client.js" asp-append-version="true"></script>
    <script>
        const status = document.getElementById("signalr-status");
        const button = document.getElementById("signalr-test");

        notificationClient.onMessage(function (message) {
            const item = document.createElement("li");
            item.textContent = message;
            document.getElementById("signalr-messages").appendChild(item);
        });

        notificationClient.onStatus(function (message, connected) {
            status.textContent = message;
            button.disabled = !connected;
        });

        button.addEventListener("click", async function () {
            try {
                await notificationClient.ping();
            } catch (error) {
                status.textContent = error.message;
            }
        });

        notificationClient.start().catch(function (error) {
            status.textContent = error.message;
        });
    </script>
}
