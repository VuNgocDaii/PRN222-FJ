@model QuanLyCuDan.Models.RegistrationListViewModel
@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Duyệt đăng ký";
}
<header class="page-header"><div><h1>Duyệt đăng ký cư dân</h1><p class="muted">Đối chiếu thông tin đăng ký với hồ sơ cư dân trước khi cấp quyền truy cập.</p></div></header>
<nav class="status-tabs" aria-label="Trạng thái đăng ký">
    <a asp-action="Index" asp-route-status="PENDING" class="@(Model.Status == "PENDING" ? "active" : "")" aria-current="@(Model.Status == "PENDING" ? "page" : null)">Chờ duyệt</a>
    <a asp-action="Index" asp-route-status="APPROVED" class="@(Model.Status == "APPROVED" ? "active" : "")" aria-current="@(Model.Status == "APPROVED" ? "page" : null)">Đã duyệt</a>
    <a asp-action="Index" asp-route-status="REJECTED" class="@(Model.Status == "REJECTED" ? "active" : "")" aria-current="@(Model.Status == "REJECTED" ? "page" : null)">Đã từ chối</a>
</nav>
@if (TempData["Message"] is string message)
{
    <p class="message success" role="status">@message</p>
}
@if (TempData["Error"] is string error)
{
    <p class="message error" role="alert">@error</p>
}
@if (Model.Users.Count == 0)
{
    <div class="panel empty">Chưa có đăng ký.</div>
}
<label class="registration-search">Tìm trong danh sách<input type="search" id="registration-search" placeholder="Họ tên, tên đăng nhập hoặc số điện thoại"></label>
<p id="registration-empty" class="muted" role="status" hidden>Không có đăng ký phù hợp.</p>
<section class="panel table-wrap">
    <table>
        <thead><tr><th>Họ và tên</th><th>Tên đăng nhập</th><th>Số điện thoại</th><th>Ngày đăng ký</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            <tr class="registration-row" data-name="@user.FullName" data-username="@user.UserName" data-phone="@user.PhoneNumber">
                <td>@user.FullName</td>
                <td>@user.UserName</td>
                <td>@(user.PhoneNumber ?? "—")</td>
                <td>@user.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(user.VerificationStatus == "PENDING" ? "Chờ duyệt" : user.VerificationStatus == "APPROVED" ? "Đã duyệt" : "Đã từ chối")
                    @if (user.VerificationStatus == "APPROVED" && user.ResidentId == null) { <br><span class="badge">Chưa liên kết hồ sơ</span> }
                </td>
                <td><button type="button" class="secondary" data-review-open="detail-@user.Id">Xem chi tiết</button></td>
            </tr>
        }
        </tbody>
    </table>
</section>
@foreach (var user in Model.Users)
{
    var profile = QuanLyCuDan.Auth.RegistrationProfileInput.Read(user.RegistrationProfile);
    var matched = Model.MatchResident(profile?.CitizenId);
    <dialog id="detail-@user.Id" class="password-dialog registration-dialog" aria-labelledby="detail-title-@user.Id">
        <div class="section-heading"><h2 id="detail-title-@user.Id">Chi tiết đăng ký</h2><button type="button" class="secondary" data-review-close>Đóng</button></div>
        <header class="section-heading">
            <div>
                <h2>@user.FullName</h2>
                <p class="muted small">@user.UserName · @(user.PhoneNumber ?? "Chưa có số điện thoại")</p>
            </div>
            <time class="muted small">@user.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</time>
        </header>
        @if (profile != null)
        {
            <section class="registration-profile"><h2>Thông tin cư dân đã đăng ký</h2><dl>
                <dt>Ngày sinh</dt><dd>@profile.DateOfBirth?.ToString("dd/MM/yyyy")</dd>
                <dt>Giới tính</dt><dd>@PortalLabels.Text(profile.Gender)</dd>
                <dt>CCCD</dt><dd>@(profile.CitizenId ?? "Không cung cấp")</dd>
                <dt>Nghề nghiệp</dt><dd>@(profile.Occupation ?? "Không cung cấp")</dd>
                <dt>Địa chỉ</dt><dd>@profile.Address</dd>
                <dt>Tổ dân phố</dt><dd>@(Model.Groups.FirstOrDefault(g => g.Id == profile.GroupId)?.Name ?? "Tổ không còn hoạt động")</dd>
                <dt>Cư trú</dt><dd>@PortalLabels.Text(profile.ResidenceStatus)</dd>
            </dl><p class="muted small">Thông tin do người đăng ký cung cấp, cần đối chiếu trước khi tạo hồ sơ chính thức.</p></section>
        }
        @if (user.VerificationStatus == "PENDING" || user.VerificationStatus == "APPROVED" && user.ResidentId == null)
        {
            <form method="post" class="review-form" data-link-only="@(user.VerificationStatus == "APPROVED" ? "true" : "false")">
                <input type="hidden" name="status" value="@Model.Status">
                <input type="hidden" name="UserId" value="@user.Id">
                <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(user.RowVersion)">
                <input type="hidden" name="Approve" value="true">
                @if (matched != null)
                {
                    <input type="hidden" name="ResidentId" value="@matched.Id">
                    <section class="registration-profile">
                        <h3>Hồ sơ trùng CCCD</h3>
                        <dl>
                            <dt>Họ tên</dt><dd>@matched.FullName</dd>
                            <dt>Ngày sinh</dt><dd>@matched.DateOfBirth.ToString("dd/MM/yyyy")</dd>
                            <dt>Giới tính</dt><dd>@PortalLabels.Text(matched.Gender)</dd>
                            <dt>CCCD</dt><dd>@matched.CitizenId</dd>
                            <dt>Điện thoại</dt><dd>@matched.PhoneNumber</dd>
                        </dl>
                    </section>
                    <p class="muted small">Khi duyệt, hệ thống liên kết hồ sơ và tự cấp quyền cư dân.</p>
                }
                <div class="inline">
                    <button type="submit" class="primary" disabled="@(matched == null && user.VerificationStatus == "APPROVED")">@(user.VerificationStatus == "APPROVED" ? "Xác nhận liên kết" : "Duyệt đăng ký")</button>
                    @if (user.VerificationStatus == "PENDING") { <button type="button" class="danger" data-review-reject>Từ chối</button> }
                </div>
            </form>
            @if (user.VerificationStatus == "PENDING")
            {
                <form method="post" class="review-form rejection-form" hidden>
                    <input type="hidden" name="status" value="@Model.Status">
                    <input type="hidden" name="UserId" value="@user.Id">
                    <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(user.RowVersion)">
                    <input type="hidden" name="Approve" value="false">
                    <button type="submit">Từ chối đăng ký</button>
                </form>
            }
        }
        else if (user.VerificationStatus == "REJECTED")
        {
            <p class="muted">Đăng ký đã bị từ chối.</p>
        }
        @if (user.ReviewedAt.HasValue)
        {
            <p class="muted small">Xét duyệt lúc @user.ReviewedAt.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p>
        }
    </dialog>
}
@section Scripts {
    <script src="~/js/registrations.js" asp-append-version="true" defer></script>
}
