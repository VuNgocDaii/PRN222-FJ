@model AdminViewModel
@{
    var access = ViewData["Permissions"] as HashSet<string> ?? new();
    var role = Model.SelectedRole;
    var readOnly = role == null || role.IsSystemRole || Model.OwnRoleIds.Contains(role.Id);
    var returnUrl = Url.Action("Index", "Admin", new { tab = "roles", roleId = role?.Id });
}
@if (access.Contains("roles.create")) {
<div id="create-role-panel" class="panel"><h2>Tạo vai trò</h2><form id="create-role" asp-controller="Roles" asp-action="Create" method="post" class="form-grid">
    <input name="returnUrl" type="hidden" value="@returnUrl"><label>Tên viết tắt<input name="Name" required maxlength="64" pattern="[A-Za-z][A-Za-z0-9_]{1,63}" placeholder="VD: CAN_BO_THU_PHI"></label><label>Tên hiển thị<input name="DisplayName" required maxlength="150"></label><label>Mô tả<input name="Description" maxlength="500"></label><button class="primary">Tạo vai trò</button>
</form></div>
}
<div class="panel"><h2>Quản lý vai trò</h2>
    <form asp-controller="Admin" asp-action="Index" method="get" data-auto-submit><input name="tab" type="hidden" value="roles"><label>Chọn vai trò<select id="edit-role" name="roleId">@foreach (var item in Model.Roles) { <option value="@item.Id" selected="@(item.Id == role?.Id)">@item.Name — @item.DisplayName</option> }</select></label><button class="secondary" data-auto-submit-button>Xem vai trò</button></form>
    @if (role != null) {
    <form id="role-details" asp-controller="Roles" asp-action="Update" asp-route-id="@role.Id" method="post" class="form-grid"><input name="returnUrl" type="hidden" value="@returnUrl"><input name="ConcurrencyStamp" type="hidden" value="@role.ConcurrencyStamp">
        <label>Tên hiển thị<input name="DisplayName" value="@role.DisplayName" required maxlength="150" readonly="@readOnly"></label><label>Mô tả<input name="Description" value="@role.Description" maxlength="500" readonly="@readOnly"></label><label class="check"><input name="IsActive" type="checkbox" value="true" checked="@role.IsActive" disabled="@readOnly">Đang hoạt động</label><input name="IsActive" type="hidden" value="false"><button class="secondary" disabled="@(readOnly || !access.Contains("roles.update"))">Lưu thông tin</button>
    </form>
    <p id="role-note" class="muted small">@(role.IsSystemRole ? "Vai trò hệ thống được bảo vệ. Hãy tạo vai trò tùy chỉnh để thay đổi quyền." : Model.OwnRoleIds.Contains(role.Id) ? "Không thể sửa vai trò đang hoặc sẽ được gán cho chính bạn." : "Cập nhật thông tin và trạng thái của vai trò.")</p>
    } else { <p class="empty">Chưa có vai trò.</p> }
</div>
@if (role != null && access.Contains("permissions.read")) {
<div id="permission-assignment-panel" class="panel"><h2>Quyền của vai trò</h2><p id="permission-note" class="muted small">Các quyền được chọn phải có phạm vi tương thích với các lần gán vai trò.</p>
    <form id="role-permissions" asp-controller="Roles" asp-action="Permissions" asp-route-id="@role.Id" method="post"><input name="returnUrl" type="hidden" value="@returnUrl"><input name="ConcurrencyStamp" type="hidden" value="@role.ConcurrencyStamp"><div id="permission-list" class="permission-grid">
    @foreach (var permission in Model.Permissions) { <label><input name="PermissionIds" type="checkbox" value="@permission.Id" checked="@role.Permissions.Any(p => p.Id == permission.Id)" disabled="@(readOnly || !access.Contains("roles.permissions.update"))"><span>@permission.Name<small>@permission.Code · @permission.Module</small></span></label> }
    </div><button class="primary" disabled="@(readOnly || !access.Contains("roles.permissions.update"))">Lưu danh sách quyền</button></form>
</div>
}
