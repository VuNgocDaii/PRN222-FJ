@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Quản lý tài khoản";
    ViewData["AdminTabs"] = true;
    var access = ViewData["Permissions"] as HashSet<string> ?? new HashSet<string>();
    var canRoles = access.Contains("roles.read");
    var canPermissions = access.Contains("permissions.read");
    var canAssign = canRoles && canPermissions && access.Contains("roles.assign") && access.Contains("accounts.read");
}
<header class="page-header">
                    <div>
                        
                        <h1 id="page-title">Quản lý tài khoản</h1>
                        
                    </div>
                    
                </header>
                <div id="notice" role="status" aria-live="polite" hidden>
                </div>
                <section id="users" class="tab-panel" hidden>
                    <div class="panel">
                        <div class="section-heading">
                            <h2>Danh sách tài khoản</h2>
                            <form id="search-users" class="inline">
                                <input name="search" placeholder="Tìm tên hoặc tài khoản" aria-label="Tìm tài khoản">
                                <button class="secondary">Tìm kiếm</button>
                            </form>
                        </div>
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Tài khoản</th>
                                        <th>Họ và tên</th>
                                        <th>Trạng thái</th>
                                        <th>Xác minh</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="user-rows">
                                </tbody>
                            </table>
                        </div>
                        <div class="pager">
                            <button id="prev-page" class="secondary">Trước</button>
                            <span id="page-info">
                            </span>
                            <button id="next-page" class="secondary">Sau</button>
                        </div>
                    </div>
                    <div id="assignments" hidden="@(!canAssign)">
                        <div class="panel">
                            <h2>Chọn người dùng</h2>
                            <label>Tài khoản<select id="assignment-user">
                                </select>
                            </label>
                            <p class="muted small">Tìm tài khoản trong danh sách để gán vai trò.</p>
                        </div>
                        <div class="panel">
                            <h2>Gán vai trò</h2>
                            <form id="assign-role" class="form-grid">
                                <label>Vai trò<select name="roleId" id="assignment-role" required>
                                    </select>
                                </label>
                                <label>Phạm vi<select name="scopeType" id="assignment-scope">
                                    </select>
                                </label>
                                <label id="assignment-unit-label" hidden>Địa bàn<select name="unitId" id="assignment-unit">
                                        <option value="">Chọn địa bàn</option>
                                    </select>
                                </label>
                                <label>Bắt đầu<input name="validFrom" type="datetime-local" required>
                                </label>
                                <label>Kết thúc (không bắt buộc)<input name="validUntil" type="datetime-local">
                                </label>
                                <button class="primary">Gán vai trò</button>
                            </form>
                        </div>
                        <div class="panel">
                            <h2>Vai trò của tài khoản</h2>
                            <div class="table-wrap">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Vai trò</th>
                                            <th>Phạm vi</th>
                                            <th>Hiệu lực</th>
                                            <th>Trạng thái</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody id="assignment-rows">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>
                <section id="roles" class="tab-panel" hidden>
                    <div id="create-role-panel" class="panel" hidden="@(!access.Contains("roles.create"))">
                        <h2>Tạo vai trò</h2>
                        <form id="create-role" class="form-grid">
                            <label>Tên viết tắt<input name="name" required pattern="[A-Za-z][A-Za-z0-9_]{1,63}" placeholder="VD: CAN_BO_THU_PHI">
                            </label>
                            <label>Tên hiển thị<input name="displayName" required maxlength="150">
                            </label>
                            <label>Mô tả<input name="description" maxlength="500">
                            </label>
                            <button class="primary">Tạo vai trò</button>
                        </form>
                    </div>
                    <div class="panel">
                        <h2>Quản lý vai trò</h2>
                        <label>Chọn vai trò<select id="edit-role">
                            </select>
                        </label>
                        <form id="role-details" class="form-grid">
                            <label>Tên hiển thị<input name="displayName" required maxlength="150">
                            </label>
                            <label>Mô tả<input name="description" maxlength="500">
                            </label>
                            <label class="check">
                                <input name="isActive" type="checkbox">Đang hoạt động</label>
                            <button class="secondary">Lưu thông tin</button>
                        </form>
                        <p id="role-note" class="muted small">
                        </p>
                    </div>
                    <div id="permission-assignment-panel" class="panel" hidden="@(!canPermissions)">
                        <h2>Quyền của vai trò</h2>
                        <p id="permission-note" class="muted small">
                        </p>
                        <form id="role-permissions">
                            <div id="permission-list" class="permission-grid">
                            </div>
                            <button class="primary" type="submit">Lưu danh sách quyền</button>
                        </form>
                    </div>
                </section>
                <section id="permissions" class="tab-panel" hidden>
                    <div id="permission-editor-panel" class="panel" hidden>
                        <h2 id="permission-editor-title">Thêm quyền</h2>
                        <form id="permission-editor" class="form-grid">
                            <label>Mã quyền
                                <input name="code" required maxlength="100" pattern="[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+" placeholder="VD: reports.export">
                            </label>
                            <label>Tên quyền
                                <input name="name" required maxlength="200">
                            </label>
                            <label>Nhóm
                                <input name="module" required maxlength="50" pattern="[A-Za-z0-9_-]+" placeholder="VD: REPORTS">
                            </label>
                            <label>Mô tả
                                <input name="description" maxlength="500">
                            </label>
                            <fieldset class="scope-choices">
                                <legend>Phạm vi áp dụng</legend>
                                <label class="check"><input type="checkbox" name="scopes" value="SYSTEM">Toàn hệ thống</label>
                                <label class="check"><input type="checkbox" name="scopes" value="SELF">Cá nhân</label>
                                <label class="check"><input type="checkbox" name="scopes" value="AREA">Khu dân cư</label>
                                <label class="check"><input type="checkbox" name="scopes" value="GROUP">Tổ dân phố</label>
                            </fieldset>
                            <div class="inline">
                                <button id="save-permission" class="primary" type="submit">Thêm quyền</button>
                                <button id="cancel-permission-edit" class="secondary" type="button" hidden>Hủy sửa</button>
                            </div>
                        </form>
                    </div>
                    <div class="panel">
                        <h2>Danh sách quyền</h2>
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Mã quyền</th>
                                        <th>Tên quyền</th>
                                        <th>Nhóm</th>
                                        <th>Phạm vi</th>
                                        <th>Vai trò sử dụng</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="permission-catalog">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            @section Scripts {
    <script src="~/js/account-display.js" asp-append-version="true" defer></script>
    <script src="~/js/admin.js" asp-append-version="true" defer></script>
}
