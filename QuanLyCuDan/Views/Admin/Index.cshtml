@model AdminViewModel
@{
    Layout = "_ManagementLayout";
    ViewData["AdminTabs"] = true;
    ViewData["AdminTab"] = Model.Tab;
    ViewData["Title"] = Model.Tab == "roles" ? "Quản lý vai trò" : Model.Tab == "permissions" ? "Quyền truy cập" : "Quản lý tài khoản";
}
<header class="page-header"><h1 id="page-title">@ViewData["Title"]</h1></header>
@if (TempData["Message"] is string message) { <div id="notice" class="message success" role="status">@message</div> }
@if (TempData["Error"] is string error) { <div class="message error" role="alert">@error</div> }
<section id="@Model.Tab" class="tab-panel admin-workspace">
    @if (Model.Tab == "users") { <partial name="_Users" model="Model" /> }
    else if (Model.Tab == "roles") { <partial name="_Roles" model="Model" /> }
    else { <partial name="_Permissions" model="Model" /> }
</section>
@section Scripts {
    <script src="~/js/admin-mvc.js" asp-append-version="true" defer></script>
}
