@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Quản trị hệ thống"; var access = ViewData["Permissions"] as HashSet<string> ?? new(); }
<header class="page-header"><h1>Quản trị hệ thống</h1></header>
<section class="panel"><h2>Chọn chức năng</h2><nav class="inline">
@if (access.Contains("accounts.read")) { <a class="primary nav-item" asp-controller="Users" asp-action="Index">Tài khoản</a> }
@if (access.Contains("roles.read")) { <a class="primary nav-item" asp-controller="Roles" asp-action="Index">Vai trò</a> }
@if (access.Contains("permissions.read")) { <a class="primary nav-item" asp-controller="Permissions" asp-action="Index">Quyền truy cập</a> }
@if (access.Contains("roles.assign")) { <a class="primary nav-item" asp-controller="RoleAssignments" asp-action="Index">Gán vai trò</a> }
</nav></section>
