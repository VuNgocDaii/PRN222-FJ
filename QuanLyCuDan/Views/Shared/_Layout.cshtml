<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · Quản lý cư dân</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="standard-layout">
    <a class="skip-link" href="#main-content">Chuyển đến nội dung</a>
    <header class="standard-header">
        <nav class="container standard-nav" aria-label="Điều hướng chính">
            <a class="app-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">KDC</span><span>Quản lý cư dân</span></a>
            <div class="standard-links">
                <a href="/">Trang công khai</a>
                @if (User.Identity?.IsAuthenticated == true) {
                    @if (ViewData["CanUseResident"] is true) { <a href="/Resident">Cổng cư dân</a> }
                    <a href="/Account/Profile">Tài khoản</a>
                    <a href="/Feedback" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Feedback" ? "page" : null)">Phản ánh / Góp ý</a>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-success" type="submit">Đăng xuất</button></form>
                } else { <a href="/Account/Login">Đăng nhập</a> }
            </div>
        </nav>
    </header>
    <main id="main-content" class="container standard-main">@RenderBody()</main>
    <footer class="standard-footer"><div class="container">KDC · Cổng thông tin cư dân <a asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_SessionToken" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
