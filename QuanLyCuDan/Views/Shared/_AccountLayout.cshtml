<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8"><link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>@ViewData["Title"] · Quản lý cư dân</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
</head>
<body class="login-page">
    <main class="login-card @(ViewData["WideAccount"] is true ? "registration-account-card" : "")">
        <a class="auth-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">CĐ</span><span>Quản lý cư dân</span></a>
        <p class="demo-label">HỆ THỐNG DEMO HỌC TẬP</p>@RenderBody()
        <p class="footnote"><a href="/">← Về trang công khai</a></p>
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
