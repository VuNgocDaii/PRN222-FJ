@model ErrorViewModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Đã xảy ra lỗi";
}
<section class="panel" style="text-align:center;padding:2rem 1rem">
    <h1>Đã xảy ra lỗi</h1>
    <p>Rất tiếc, hệ thống không thể xử lý yêu cầu của bạn. Vui lòng thử lại sau ít phút.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted small">Mã lỗi để báo cho ban quản lý: <code>@Model.RequestId</code></p>
    }
    <p><a class="button primary" href="/">Về trang chủ</a></p>
</section>
