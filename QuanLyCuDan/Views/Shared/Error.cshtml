@model ErrorViewModel
@{ ViewData["Title"] = "Thông báo lỗi"; }
<section class="card border p-4 mb-4" role="alert">
<h1 class="text-danger">Không thể hiển thị trang</h1>
<p>Đã xảy ra lỗi khi xử lý yêu cầu. Vui lòng thử lại hoặc liên hệ người phụ trách hệ thống.</p>
@if (Model.ShowRequestId) { <p><strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code></p> }
<div><a class="btn btn-primary" href="/">Về trang chủ</a></div>
</section>
