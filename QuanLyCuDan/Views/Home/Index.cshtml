@model PublicHomeViewModel
@{ Layout = "_PortalLayout"; ViewData["Title"] = "Trang công khai"; }
<section class="community-hero"><p class="eyebrow">CỔNG THÔNG TIN THÔN</p><h1>Thông báo của thôn<br>và gửi ý kiến dễ dàng</h1><div class="hero-actions">@if (User.Identity?.IsAuthenticated == true) { <a href="/Resident" class="button primary">Vào trang cư dân</a> } else { <p>Bấm “Đăng nhập” để vào. Nếu chưa có tài khoản, bấm “Đăng ký”.</p><a href="/Account/Login" class="button primary">Đăng nhập</a><a href="/Account/Register" class="button secondary">Đăng ký tài khoản</a> }</div></section>

<section id="announcements" class="announcement-section">
    <div class="section-heading"><div><p class="eyebrow">THÔNG TIN TỪ THÔN</p><h2>Thông báo mới</h2></div></div>
    @if (Model.Announcements.Count == 0) { <div class="empty-state"><h3>Chưa có thông báo nào</h3><p>Thông báo mới của thôn sẽ xuất hiện tại đây.</p></div> }
    <div class="announcement-grid">
    @foreach (var item in Model.Announcements)
    {
        <article class="announcement-card"><div class="card-meta"><time>@item.PublishedAt?.AddHours(7).ToString("dd/MM/yyyy")</time></div><h3><a href="/thong-bao/@item.Id">@item.Title</a></h3><p>@(item.Body.Length > 170 ? item.Body[..170] + "…" : item.Body)</p><a href="/thong-bao/@item.Id" class="read-more" aria-label="Đọc thông báo: @item.Title">Đọc thông báo <span aria-hidden="true">→</span></a></article>
    }
    </div>
    @if (Model.Total > 9) { <nav class="pagination" aria-label="Phân trang thông báo">@if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)">← Trang trước</a> }<span>Trang @Model.Page / @((int)Math.Ceiling(Model.Total / 9d))</span>@if (Model.Page * 9 < Model.Total) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)">Trang sau →</a> }</nav> }
</section>

